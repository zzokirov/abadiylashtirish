# Django sozlamalari
# Yangi kalit: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=production-secret-key-change-this-immediately
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,domain.uz,www.domain.uz
# Sayt HTTPS orqali ochilganda True qiling (xavfsiz cookie va HSTS yoqiladi)
DJANGO_USE_HTTPS=False
CSRF_TRUSTED_ORIGINS=https://domain.uz,https://www.domain.uz,http://localhost

# Ommaviy QR manzilining asosi (qabr toshidagi QR manzil shu asosda generatsiya bo'ladi)
# DIQQAT: toshlarga QR o'yilgandan keyin bu qiymatni o'zgartirmang!
FRONTEND_PUBLIC_BASE_URL=https://domain.uz/m

# PostgreSQL ma'lumotlar bazasi
DB_ENGINE=django.db.backends.postgresql
DB_NAME=abadiy_xotira_db
DB_USER=postgres
DB_PASSWORD=strong_postgres_password_2026
DB_HOST=db
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=https://domain.uz,http://localhost:3000
